# Environment
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/gharkhana_dev

# Redis
REDIS_URL=redis://localhost:6379

# JWT Secrets
JWT_ACCESS_SECRET=super-secret-access-token-key-change-in-production-min-32-chars
JWT_REFRESH_SECRET=super-secret-refresh-token-key-change-in-production-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Mobile Client Base URL
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
