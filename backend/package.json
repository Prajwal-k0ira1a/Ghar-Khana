    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "test:auth": "tsx src/test/auth-integration.test.ts",
    "test:subscriptions": "tsx src/test/subscription-engine.test.ts",
    "test:provider": "tsx src/test/provider-operations.test.ts",
    "test:payments": "tsx src/test/payment-flow.test.ts",
    "test:delivery": "tsx src/test/delivery-lifecycle.test.ts",
    "test:trust": "tsx src/test/notifications-reviews.test.ts",
    "test": "tsx src/test/auth-integration.test.ts && tsx src/test/subscription-engine.test.ts && tsx src/test/provider-operations.test.ts && tsx src/test/payment-flow.test.ts && tsx src/test/delivery-lifecycle.test.ts && tsx src/test/notifications-reviews.test.ts"
  },
  "dependencies": {
    "@gharkhana/types": "workspace:*",
    "@gharkhana/validation": "workspace:*",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.41.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.3",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.5.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "pino-pretty": "^13.0.0",
